//@version=5
strategy("Simple VWAP + 9/21 EMA Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1)

// ==========================================
// INPUTS
// ==========================================
fastLen    = input.int(9, title="Fast EMA Length", group="EMA Settings")
slowLen    = input.int(21, title="Slow EMA Length", group="EMA Settings")

vwapSrc    = input.source(hlc3, title="VWAP Source", group="VWAP Settings")
vwapAnchor = input.string("Session", title="Anchor Period", options=["Session", "Week", "Month"], group="VWAP Settings")

// ==========================================
// CALCULATIONS
// ==========================================
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)

// VWAP Anchor logic
isNewPeriod = switch vwapAnchor
    "Session" => timeframe.change("D")
    "Week"    => timeframe.change("W")
    "Month"   => timeframe.change("M")
    => timeframe.change("D")

[vwapVal, _, _] = ta.vwap(vwapSrc, isNewPeriod, 1.0)

// ==========================================
// STRATEGY LOGIC
// ==========================================
// Directional filter: 9 EMA above 21 EMA means bullish bias
bool bullishBias = fastEma > slowEma
bool bearishBias = fastEma < slowEma

// Entry triggers: Price crosses VWAP aligned with EMA trend direction
bool longCondition  = ta.crossover(close, vwapVal) and bullishBias
bool shortCondition = ta.crossunder(close, vwapVal) and bearishBias

if longCondition
    strategy.entry("Long", strategy.long)

if shortCondition
    strategy.entry("Short", strategy.short)

// ==========================================
// PLOTS
// ==========================================
plot(fastEma, title="9 EMA", color=color.rgb(52, 152, 219), linewidth=2)
plot(slowEma, title="21 EMA", color=color.rgb(243, 156, 18), linewidth=2)
plot(vwapVal, title="VWAP", color=color.white, linewidth=2)
