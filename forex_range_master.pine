//@version=6
strategy("Range Master OG - Static Sniper", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=50)

// ─── INPUTS ───
bb_len    = input.int(20, "BB Length")
bb_mult   = input.float(2.5, "BB StdDev")
wick_per  = input.float(25.0, "Min Wick %") 
sl_pct    = input.float(1.0, "Stop Loss %") 

// ─── GLOBAL CALCULATIONS ───
[basis, upper, lower] = ta.bb(close, bb_len, bb_mult)
cross_basis = ta.cross(close, basis) 

// ─── REJECTION LOGIC ───
candle_range = high - low
upper_wick   = high - math.max(open, close)
lower_wick   = math.min(open, close) - low
curr_wick_up = candle_range > 0 ? (upper_wick / candle_range) * 100 : 0
curr_wick_dn = candle_range > 0 ? (lower_wick / candle_range) * 100 : 0

short_rej = high >= upper and candle_range > 0 and curr_wick_up > wick_per
long_rej  = low <= lower and candle_range > 0 and curr_wick_dn > wick_per

// ─── EXECUTION ───
if (long_rej and strategy.position_size == 0)
    strategy.entry("Long", strategy.long, comment="Wick Rej")
if (short_rej and strategy.position_size == 0)
    strategy.entry("Short", strategy.short, comment="Wick Rej")
if (strategy.position_size > 0 and cross_basis)
    strategy.close("Long", comment="Mean Hit")
if (strategy.position_size < 0 and cross_basis)
    strategy.close("Short", comment="Mean Hit")

// ─── VISUALS ───
bgcolor(long_rej ? color.new(color.lime, 85) : na)
bgcolor(short_rej ? color.new(color.red, 85) : na)

plot(basis, color=color.new(color.gray, 50))
plot(upper, color=color.red, linewidth=2)
plot(lower, color=color.lime, linewidth=2)

// ─── THE STATIC FLIGHT MANUAL (Bottom Right) ───
var table manual = table.new(position.bottom_right, 1, 6, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(manual, 0, 0, "⚠️ SNIPER RULES ⚠️", text_color=color.yellow, text_size=size.small)
    table.cell(manual, 0, 1, "1. Candle MUST be Closed", text_color=color.white, text_halign=text.align_left)
    table.cell(manual, 0, 2, "2. Wick MUST be > 25%", text_color=color.white, text_halign=text.align_left)
    table.cell(manual, 0, 3, "3. Body MUST be Inside Band", text_color=color.white, text_halign=text.align_left)
    table.cell(manual, 0, 4, "4. NO 'Hugging' the Bands", text_color=color.white, text_halign=text.align_left)
    table.cell(manual, 0, 5, "5. NO High-Impact News", text_color=color.white, text_halign=text.align_left)
