//@version=5
strategy("Forex Range Master - Structural Fix", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=50)

// ─── INPUTS ───
bb_len   = input.int(20, "BB Length")
bb_mult  = input.float(2.2, "StdDev (Tighten for higher PnL)")
min_pipe = input.float(5.0, "Min Bandwidth (Pips)", tooltip="Avoids the 'Squeeze' trap")

// ─── INDICATORS ───
[basis, upper, lower] = ta.bb(close, bb_len, bb_mult)
bandwidth = (upper - lower) / syminfo.mintick / 10 // Convert to Pips

// Basis Slope (Angle of the Mean)
slope = basis - basis[1]

// ─── REFINED ENTRY LOGIC ───
// Long: Price is at the lower band + Basis is NOT crashing down + Bands aren't squeezed
long_entry  = ta.crossover(close, lower) and slope > -0.0001 and bandwidth > min_pipe
// Short: Price is at the upper band + Basis is NOT surging up + Bands aren't squeezed
short_entry = ta.crossunder(close, upper) and slope < 0.0001 and bandwidth > min_pipe

// ─── EXECUTION ───
if (long_entry and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

if (short_entry and strategy.position_size == 0)
    strategy.entry("Short", strategy.short)

// ─── DYNAMIC EXIT ───
// Exit at Mean (Basis) or Opposite Band for "Big Winners"
if (strategy.position_size > 0 and ta.crossover(close, basis))
    strategy.close("Long", comment="Mean Hit")

if (strategy.position_size < 0 and ta.crossunder(close, basis))
    strategy.close("Short", comment="Mean Hit")

// Hard Stop Loss based on volatility
strategy.exit("SL", stop=strategy.position_avg_price * (strategy.position_size > 0 ? 0.998 : 1.002))
