//@version=5
strategy("Forex Market-Order Range - 2026 Edition", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=50)

// ─── INPUTS ───
bb_len   = input.int(20, "BB Length")
bb_mult  = input.float(2.5, "BB StdDev (Extreme Only)")
wick_per = input.float(30.0, "Min Wick % of Candle", tooltip="Ensures price rejected the level")

// ─── INDICATORS ───
[basis, upper, lower] = ta.bb(close, bb_len, bb_mult)

// ─── REJECTION LOGIC ───
candle_range = high - low
upper_wick = high - math.max(open, close)
lower_wick = math.min(open, close) - low

// Is it a "Pin Bar" rejection at the band? (Using tooltip-corrected logic)
// We calculate wick percentage relative to the total candle size
short_rej = high >= upper and candle_range > 0 and (upper_wick / candle_range) * 100 > wick_per
long_rej  = low <= lower and candle_range > 0 and (lower_wick / candle_range) * 100 > wick_per

// ─── ENTRY (MARKET ORDERS) ───
// We enter when the current candle closes confirming the rejection
if (long_rej and strategy.position_size == 0)
    strategy.entry("Long", strategy.long, comment="Wick Rejection")

if (short_rej and strategy.position_size == 0)
    strategy.entry("Short", strategy.short, comment="Wick Rejection")

// ─── DYNAMIC EXIT ───
// Exit at the MOVING mean (Basis)
if (strategy.position_size > 0 and ta.crossover(close, basis))
    strategy.close("Long", comment="Mean Hit")

if (strategy.position_size < 0 and ta.crossunder(close, basis))
    strategy.close("Short", comment="Mean Hit")

// Emergency Stop (0.5% from average price)
if (strategy.position_size != 0)
    strategy.exit("SL", stop=strategy.position_avg_price * (strategy.position_size > 0 ? 0.995 : 1.005))

// ─── VISUALS ───
plot(basis, color=color.new(color.gray, 50))
plot(upper, color=color.red)
plot(lower, color=color.lime)
plotshape(short_rej, style=shape.triangledown, location=location.abovebar, color=color.red)
plotshape(long_rej, style=shape.triangleup, location=location.belowbar, color=color.lime)
