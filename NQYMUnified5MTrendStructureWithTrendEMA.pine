//@version=5
indicator("NQ/YM Unified 5M Trend + Structure (Dashboard)", overlay=true, max_lines_count=500)

// ==========================================
// INPUTS
// ==========================================
useEma9       = input.bool(true, title="Show 9 EMA?", group="Core EMA Settings")
fastLen       = input.int(9, title="Fast EMA Length", group="Core EMA Settings")
useEma21      = input.bool(true, title="Show 21 EMA?", group="Core EMA Settings")
slowLen       = input.int(21, title="Slow EMA Length", group="Core EMA Settings")

// Trend Context EMA Settings (Visual Only)
useTrendEma   = input.bool(true, title="Show Trend EMA?", group="Trend Context EMA")
trendLen      = input.int(50, title="Trend EMA Length", group="Trend Context EMA")

// Optional Long-Term EMAs (Visual Only - No Execution Impact)
useEma120     = input.bool(false, title="Show 120 EMA?", group="Optional Long-Term EMAs")
ema120Len     = input.int(120, title="120 EMA Length", group="Optional Long-Term EMAs")
useEma200     = input.bool(false, title="Show 200 EMA?", group="Optional Long-Term EMAs")
ema200Len     = input.int(200, title="200 EMA Length", group="Optional Long-Term EMAs")

// Structure Break Confirmation
breakLookback = input.int(5, title="Breakout Lookback Bars", group="Structure Confirmation")

// Micro-HTF Settings (Toggleable)
useHtfFilter  = input.bool(true, title="Enable 5M Micro-HTF Filter?", group="HTF Alignment")
htfResolution = input.timeframe("5", title="Micro-HTF Timeframe", group="HTF Alignment")

// Choppiness Index Filter
useChopFilter = input.bool(true, title="Enable Choppiness Index Filter?", group="Anti-Chop Filter")
chopLen       = input.int(14, title="CHOP Length", group="Anti-Chop Filter")
chopThreshold = input.float(55.0, title="Max Allowed CHOP (Below = Trend)", group="Anti-Chop Filter")

// ATR Risk Management & Visual Levels
useTpSl           = input.bool(true, title="Draw SL & TP Lines?", group="Risk Management")
showHistory       = input.bool(true, title="Show Historical SL/TP Lines", group="Risk Management")
showSignalHistory = input.bool(false, title="Show Historical BUY/SELL Signals", group="Risk Management")
atrLen            = input.int(14, title="ATR Period", group="Risk Management")
slAtrMult         = input.float(1.5, title="Stop Loss (x ATR)", group="Risk Management")
rrRatio           = input.float(2.0, title="Risk-to-Reward Ratio (TP)", group="Risk Management")

// Signal Display Toggles
showBuySignals  = input.bool(true, title="Show BUY Labels", group="Signal Display Settings")
showSellSignals = input.bool(true, title="Show SELL Labels", group="Signal Display Settings")

// Dashboard Settings
showDashboard   = input.bool(true, title="Show Trading Dashboard", group="Dashboard Settings")

// ==========================================
// CALCULATIONS
// ==========================================
fastEma  = ta.ema(close, fastLen)
slowEma  = ta.ema(close, slowLen)
trendEma = ta.ema(close, trendLen)
ema120   = ta.ema(close, ema120Len)
ema200   = ta.ema(close, ema200Len)
atrVal   = ta.atr(atrLen)

// Dynamic Color for Trend EMA (Green if Price >= EMA, Red if Price < EMA)
trendEmaColor = close >= trendEma ? color.green : color.red

// 1. Structure Breakout Levels (5-Bar Range)
highestRecent = ta.highest(high, breakLookback)[1]
lowestRecent  = ta.lowest(low, breakLookback)[1]

confirmBuy  = (fastEma > slowEma) and (close > highestRecent)
confirmSell = (fastEma < slowEma) and (close < lowestRecent)

// 2. Micro-HTF Order Flow Alignment (5M Timeframe)
htfFastEma = request.security(syminfo.tickerid, htfResolution, ta.ema(close, fastLen), barmerge.gaps_off, barmerge.lookahead_off)
htfSlowEma = request.security(syminfo.tickerid, htfResolution, ta.ema(close, slowLen), barmerge.gaps_off, barmerge.lookahead_off)

htfBullish = htfFastEma > htfSlowEma
htfBearish = htfFastEma < htfSlowEma

condHtfBuy  = useHtfFilter ? htfBullish : true
condHtfSell = useHtfFilter ? htfBearish : true

// 3. Choppiness Index Filter (Active in code, hidden from table)
ciSum   = math.sum(ta.tr(true), chopLen)
ciMax   = ta.highest(high, chopLen)
ciMin   = ta.lowest(low, chopLen)
chopVal = 100 * (math.log10(ciSum / (ciMax - ciMin)) / math.log10(chopLen))

passChop = useChopFilter ? (chopVal < chopThreshold) : true

// ==========================================
// UNIFIED SIGNAL LOGIC
// ==========================================
rawBuy  = confirmBuy and condHtfBuy and passChop
rawSell = confirmSell and condHtfSell and passChop

// ==========================================
// EXECUTION & DYNAMIC LINE MANAGEMENT
// ==========================================
candleClosed = barstate.isconfirmed

var int signalState = 0 
var float activeSL   = na
var float activeTP   = na

var line currentSlLine = line(na)
var line currentTpLine = line(na)

// Arrays to track dynamic labels for history control
var label[] activeLabels = array.new_label()

bool finalBuy  = false
bool finalSell = false

if candleClosed
    // Check exits for active trades first
    if signalState == 1
        bool hitTp   = high >= activeTP
        bool hitSl   = low <= activeSL
        bool crossExit = ta.crossunder(fastEma, slowEma)
        
        if hitTp or hitSl or crossExit
            if not showHistory and not na(currentSlLine)
                line.delete(currentSlLine)
                line.delete(currentTpLine)
            signalState := 0

    else if signalState == -1
        bool hitTp   = low <= activeTP
        bool hitSl   = high >= activeSL
        bool crossExit = ta.crossover(fastEma, slowEma)
        
        if hitTp or hitSl or crossExit
            if not showHistory and not na(currentSlLine)
                line.delete(currentSlLine)
                line.delete(currentTpLine)
            signalState := 0

    // New Entries
    if rawBuy and signalState == 0
        finalBuy    := true
        signalState := 1
        if useTpSl
            activeSL := close - (atrVal * slAtrMult)
            activeTP := close + ((close - activeSL) * rrRatio)
            
            currentSlLine := line.new(bar_index, activeSL, bar_index, activeSL, color=color.red, style=line.style_dashed, width=2)
            currentTpLine := line.new(bar_index, activeTP, bar_index, activeTP, color=color.green, style=line.style_dashed, width=2)

        if showBuySignals
            if not showSignalHistory and array.size(activeLabels) > 0
                // Delete previous label if history is hidden
                label.delete(array.shift(activeLabels))
            
            lbl = label.new(bar_index, low, text="BUY", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
            array.push(activeLabels, lbl)

    else if rawSell and signalState == 0
        finalSell   := true
        signalState := -1
        if useTpSl
            activeSL := close + (atrVal * slAtrMult)
            activeTP := close - ((activeSL - close) * rrRatio)
            
            currentSlLine := line.new(bar_index, activeSL, bar_index, activeSL, color=color.red, style=line.style_dashed, width=2)
            currentTpLine := line.new(bar_index, activeTP, bar_index, activeTP, color=color.green, style=line.style_dashed, width=2)

        if showSellSignals
            if not showSignalHistory and array.size(activeLabels) > 0
                // Delete previous label if history is hidden
                label.delete(array.shift(activeLabels))
            
            lbl = label.new(bar_index, high, text="SELL", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
            array.push(activeLabels, lbl)

// Dynamically extend active lines forward while trade is open; freeze them upon exit
if signalState != 0 and not na(currentSlLine)
    line.set_x2(currentSlLine, bar_index)
    line.set_x2(currentTpLine, bar_index)

// ==========================================
// DASHBOARD / CHECKLIST TABLE UI
// ==========================================
var table checklistTable = table.new(position = position.top_right, columns = 2, rows = 4, bgcolor = color.new(color.black, 20), border_color = color.gray, border_width = 1)

if barstate.islast and showDashboard
    // Determine macro bias text and color
    bool isBullishBias = (close >= trendEma) and (fastEma > slowEma)
    string biasText = isBullishBias ? "BULLISH 🟢" : "BEARISH 🔴"
    color biasColor = isBullishBias ? color.new(color.green, 20) : color.new(color.red, 20)

    // Row 0: Title Header
    table.cell(checklistTable, 0, 0, "TRADING DASHBOARD", text_color=color.white, text_size=size.small, bgcolor=color.gray)
    table.cell(checklistTable, 1, 0, "STATUS", text_color=color.white, text_size=size.small, bgcolor=color.gray)

    // Row 1: Macro Bias
    table.cell(checklistTable, 0, 1, "Macro Trend", text_color=color.white, text_size=size.small)
    table.cell(checklistTable, 1, 1, biasText, text_color=color.white, text_size=size.small, bgcolor=biasColor)

    // Row 2: EMA Stack Check
    bool emaAligned = math.abs(fastEma - slowEma) > (atrVal * 0.05)
    table.cell(checklistTable, 0, 2, "9/21 EMA Separation", text_color=color.white, text_size=size.small)
    table.cell(checklistTable, 1, 2, emaAligned ? "FANNED [OK]" : "TANGLED [CHOP]", text_color=color.white, text_size=size.small, bgcolor=emaAligned ? color.new(color.green, 50) : color.new(color.orange, 50))

    // Row 3: HTF Alignment Check
    table.cell(checklistTable, 0, 3, "5M HTF Filter", text_color=color.white, text_size=size.small)
    table.cell(checklistTable, 1, 3, htfBullish ? "BULLISH" : "BEARISH", text_color=color.white, text_size=size.small, bgcolor=htfBullish ? color.new(color.green, 50) : color.new(color.red, 50))

else if barstate.islast and not showDashboard
    table.clear(checklistTable, 0, 0, 1, 3) // Clear table cells if dashboard is toggled off

// ==========================================
// PLOTTING & VISUALS
// ==========================================
plot(useEma9 ? fastEma : na, title="9 EMA", color=color.rgb(33, 150, 243), linewidth=2)
plot(useEma21 ? slowEma : na, title="21 EMA", color=color.rgb(255, 152, 0), linewidth=2)
plot(useTrendEma ? trendEma : na, title="Trend EMA (50)", color=trendEmaColor, linewidth=3)

// Optional Long-Term EMAs Plots
plot(useEma120 ? ema120 : na, title="120 EMA", color=color.rgb(156, 39, 176), linewidth=2)
plot(useEma200 ? ema200 : na, title="200 EMA", color=color.rgb(96, 125, 139), linewidth=2)

// Background highlight: Green = Bullish 5M HTF, Red = Bearish 5M HTF (Only if enabled)
bgcolor(useHtfFilter ? (htfBullish ? color.new(color.green, 93) : color.new(color.red, 93)) : na, title="5M HTF Bias")
